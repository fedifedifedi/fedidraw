{
  "name": "fedidraw",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time doodle recognition that runs entirely in your browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
